
GPU_COUNT=1

JOB_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO

REDIS_HOST=redis
REDIS_PORT=6379

# Скільки активних (queued+running) задач може мати один student_id одночасно
MAX_QUEUE_PER_STUDENT=3

# Максимальний розмір .zip датасету в МБ
MAX_DATASET_SIZE_MB=500

# Admin API key — потрібен для доступу до /admin
# Залиш порожнім щоб вимкнути admin panel.
# Згенеруй один раз: openssl rand -hex 24
ADMIN_API_KEY=2ac0b42ab29af3942a2136a65a180c21337e7bf824b6e8f7

# Якщо true — всі submit-job запити вимагають валідний X-API-Key (видається адміном)
# Якщо false — поле student_id у формі береться "на віру" (зручно для тестів)
REQUIRE_STUDENT_KEY=false
